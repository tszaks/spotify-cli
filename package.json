{
  "name": "spotify-cli",
  "version": "2.0.0",
  "description": "Control Spotify from the command line, by a person or by an AI agent",
  "main": "dist/index.js",
  "scripts": {
    "build": "rm -rf dist && tsc -p tsconfig.json && chmod +x dist/index.js",
    "dev": "tsx src/index.ts",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "keywords": [
    "spotify",
    "cli",
    "spotify-connect",
    "spotify-web-api",
    "typescript",
    "agent"
  ],
  "author": "Tyler Szakacs",
  "bin": {
    "spot": "dist/index.js"
  },
  "files": [
    "dist",
    "skills",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "license": "MIT",
  "homepage": "https://github.com/tszaks/spotify-cli#readme",
  "bugs": {
    "url": "https://github.com/tszaks/spotify-cli/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/tszaks/spotify-cli.git"
  },
  "type": "module",
  "dependencies": {
    "commander": "^14.0.3",
    "open": "^11.0.0"
  },
  "devDependencies": {
    "@types/node": "^25.4.0",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3",
    "vitest": "^4.1.0"
  }
}
